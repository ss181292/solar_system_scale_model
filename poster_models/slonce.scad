module qr_code() {
    color(color_black) {
        for (row = [0 : qr_modules - 1])
            for (col = [0 : qr_modules - 1])
                if (qr_matrix[row][col] == 1)
                    translate([68.2000 + col * qr_cell,
                               18.6750 + (qr_modules - 1 - row) * qr_cell,
                               2.0])
                        cube([qr_cell, qr_cell, 0.3]);
        translate([106.0000, 14.0000, 2.0])
            linear_extrude(height = 0.3)
                text(qr_url, size = 3.1750, font = "Baloo 2:style=Bold",
                     halign = "right", valign = "bottom");
    }
}

