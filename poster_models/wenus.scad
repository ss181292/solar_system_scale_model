qr_url = "https://wenus.orbity.pl";

module base_plate() {
    color(color_white)
        cube([plaque_width, plaque_height, plaque_thickness]);
}

module frame() {
    s = plaque_width - 2 * frame_width;
    color(color_black) {
        translate([0, 0, plaque_thickness])
            cube([frame_width, plaque_height, frame_height]);
        translate([plaque_width - frame_width, 0, plaque_thickness])
            cube([frame_width, plaque_height, frame_height]);
        translate([frame_width, 0, plaque_thickness])
            cube([s, frame_width, frame_height]);
        translate([frame_width, plaque_height - frame_width, plaque_thickness])
            cube([s, frame_width, frame_height]);
    }
}

module screw_island(x, y) {
    translate([x, y, plaque_thickness])
        cylinder(h=island_height, d1=island_base_diameter, d2=island_top_diameter, $fn=48);
}
module screw_islands() {
    color(color_black) {
        screw_island(screw_x, screw_y_top);
        screw_island(screw_x, screw_y_bottom);
    }
}
module screw_hole(x, y) {
    eps = 0.2;
    r1 = screw_hole_diameter / 2;
    r2 = countersink_diameter / 2;
    z0 = -eps;
    z1 = plaque_thickness + island_height - countersink_depth;
    z2 = plaque_thickness + island_height;
    z3 = max(z2, plaque_thickness + frame_height) + eps;
    translate([x, y, 0])
        rotate_extrude($fn=32)
            polygon([[0,z0],[r1,z0],[r1,z1],[r2,z2],[r2,z3],[0,z3]]);
}
module screw_holes() {
    screw_hole(screw_x, screw_y_top);
    screw_hole(screw_x, screw_y_bottom);
}

module body_text() {
    color(color_black) {
        translate([14.0000, 156.0000, 2.0]) linear_extrude(height = 0.3) text("♀", size = 9.8778, font = "Liberation Sans:style=Bold", halign = "left", valign = "top");
